{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "paths": {
      "@korus-dev/agent-ui-sdk": [
        "../src/vue/index.ts"
      ],
      "@korus-dev/agent-ui-sdk/native": [
        "../src/vue/native/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "vite*.config.ts",
    "live-chat-server.ts"
  ]
}
