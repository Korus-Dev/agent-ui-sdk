{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Vue renderers, DOM interaction controls, and browser media APIs need DOM types.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "paths": {
      "@korus-dev/agent-ui-sdk": [
        "./src/vue/index.ts"
      ],
      "@korus-dev/agent-ui-sdk/host": [
        "./src/host/contracts.ts"
      ],
      "@korus-dev/agent-ui-sdk/electron": [
        "./src/electron/index.ts"
      ],
      "@korus-dev/agent-ui-sdk/electron/preload": [
        "./src/electron/preload.ts"
      ],
      "@korus-dev/agent-ui-sdk/electron/browser": [
        "./src/browser/electron.ts"
      ],
      "@korus-dev/agent-ui-sdk/speech": [
        "./src/speech/index.ts"
      ],
      "@korus-dev/agent-ui-sdk/browser": [
        "./src/browser/index.ts"
      ],
      "@korus-dev/agent-ui-sdk/browser-ui": [
        "./src/vue/browser/index.ts"
      ],
      "@korus-dev/agent-ui-sdk/documents": [
        "./src/documents/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
