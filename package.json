{
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "assets",
    "native"
  ],
  "scripts": {
    "build": "vite build && node scripts/typecheck.mjs vue -p tsconfig.build.json && node scripts/package-katex-assets.mjs dist/styles.css dist/fonts && node scripts/verify-package-css.mjs dist/styles.css dist/vue/index.d.ts dist/fonts && node scripts/verify-native-assets.mjs",
    "typecheck": "node scripts/typecheck.mjs vue --noEmit && npm run typecheck:composition && npm run typecheck:lab",
    "typecheck:composition": "node scripts/typecheck.mjs vue -p tsconfig.composition.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:lab": "vite --config lab/vite.config.ts",
    "build:lab": "vite build --config lab/vite.config.ts",
    "typecheck:lab": "node scripts/typecheck.mjs vue -p lab/tsconfig.json --noEmit",
    "test:lab": "vitest run --config lab/vitest.config.ts",
    "test:lab:browser": "node scripts/test-lab-browsers.mjs"
  },
  "name": "@korus-dev/agent-ui-sdk",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./host": {
      "types": "./dist/host/contracts.d.ts",
      "import": "./dist/host/contracts.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload.d.ts",
      "import": "./dist/electron/preload.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "import": "./dist/speech/index.js"
    },
    "./browser/*": {
      "types": "./dist/browser/*.d.ts",
      "import": "./dist/browser/*.js"
    },
    "./browser-ui": {
      "types": "./dist/vue/browser/index.d.ts",
      "import": "./dist/vue/browser/index.js"
    },
    "./documents/*": {
      "types": "./dist/documents/*.d.ts",
      "import": "./dist/documents/*.js"
    },
    "./native": {
      "types": "./dist/vue/native/index.d.ts",
      "import": "./dist/vue/native/index.js"
    }
  },
  "dependencies": {
    "@pierre/highlights": "0.2.0",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@tabler/icons-vue": "3.45.0",
    "beautiful-mermaid": "1.1.3",
    "fix-webm-duration": "1.0.6",
    "katex": "0.17.0",
    "marked": "17.0.6",
    "marked-katex-extension": "5.1.10",
    "shiki": "4.3.1",
    "ws": "8.22.2",
    "parse-git-diff": "0.0.20",
    "@korus-dev/multi-agent-sdk": "0.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "electron": ">=30",
    "element-plus": ">=2.13"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "element-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Reusable capability-driven Vue controls and optional native host adapters for agent applications.",
  "devDependencies": {
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.35",
    "@vue/test-utils": "2.4.11",
    "electron": "43.1.1",
    "element-plus": "2.14.1",
    "jsdom": "29.1.1",
    "vue": "3.5.35",
    "vue-tsc": "3.3.7",
    "playwright": "1.63.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Korus-Dev/agent-ui-sdk.git"
  }
}
