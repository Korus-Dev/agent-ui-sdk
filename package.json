{
  "version": "0.25.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "assets",
    "native",
    "INTEGRATION.md",
    "docs/guide",
    "examples",
    "docs/api",
    "docs/index.md",
    "CHANGELOG.md",
    "*.js",
    "*.d.ts",
    "styles.css",
    "electron"
  ],
  "scripts": {
    "build": "vite build && node scripts/typecheck.mjs vue -p tsconfig.build.json && node scripts/package-katex-assets.mjs dist/styles.css dist/fonts && node scripts/verify-package-css.mjs dist/styles.css dist/vue/index.d.ts dist/fonts && node scripts/verify-native-assets.mjs",
    "typecheck": "node scripts/typecheck.mjs vue --noEmit && npm run typecheck:composition && npm run typecheck:lab",
    "typecheck:composition": "node scripts/typecheck.mjs vue -p tsconfig.composition.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:lab": "vite --config lab/vite.config.ts",
    "build:lab": "vite build --config lab/vite.config.ts",
    "typecheck:lab": "node scripts/typecheck.mjs vue -p lab/tsconfig.json --noEmit",
    "test:lab": "vitest run --config lab/vitest.config.ts",
    "test:lab:browser": "node scripts/test-lab-browsers.mjs",
    "build:samples": "node scripts/build-samples.mjs",
    "typecheck:samples": "node scripts/typecheck.mjs vue -p samples/shared/tsconfig.json --noEmit",
    "dev:basic": "npm run build:samples && node scripts/run-sample.mjs basic",
    "start:basic": "npm run build:samples && node scripts/run-sample.mjs basic",
    "build:basic": "npm run build:samples",
    "dev:spark": "npm run build:samples && node scripts/run-sample.mjs spark",
    "start:spark": "npm run build:samples && node scripts/run-sample.mjs spark",
    "build:spark": "npm run build:samples",
    "dev:relay": "npm run build:samples && node scripts/run-sample.mjs relay",
    "start:relay": "npm run build:samples && node scripts/run-sample.mjs relay",
    "build:relay": "npm run build:samples",
    "check": "npm run typecheck && npm run test:coverage -- --maxWorkers=4 && npm run build && npm run check:package && npm run build:lab && npm run build:samples && npm run test:samples && npm run build:docs",
    "check:package": "node scripts/verify-package.mjs",
    "build:docs": "vitepress build docs",
    "dev:docs": "vitepress dev docs",
    "test:samples": "vitest run --config samples/vitest.config.ts",
    "test:native:smoke": "node scripts/test-native-smoke.mjs",
    "build:apple-speech": "node scripts/build-apple-speech.mjs",
    "prepublishOnly": "npm run check",
    "test:watch": "vitest",
    "check:release": "node scripts/check-release.mjs",
    "test:samples:browser": "node --import tsx samples/shared/samples.browser.mjs"
  },
  "name": "@korus-dev/agent-ui-sdk",
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@korus-dev/multi-agent-sdk": "0.25.0",
    "@pierre/highlights": "0.2.0",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@tabler/icons-vue": "3.45.0",
    "beautiful-mermaid": "1.1.3",
    "fix-webm-duration": "1.0.6",
    "katex": "0.17.0",
    "marked": "17.0.6",
    "marked-katex-extension": "5.1.10",
    "parse-git-diff": "0.0.20",
    "shiki": "4.3.1",
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "electron": ">=30",
    "element-plus": ">=2.13",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "element-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Reusable capability-driven Vue controls and optional native host adapters for agent applications.",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "25.9.5",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/server-renderer": "3.5.35",
    "@vue/test-utils": "2.4.11",
    "electron": "43.1.1",
    "element-plus": "2.14.1",
    "jsdom": "29.1.1",
    "playwright": "1.63.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.35",
    "vue-tsc": "3.3.7",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Korus-Dev/agent-ui-sdk.git"
  },
  "homepage": "https://github.com/Korus-Dev/agent-ui-sdk#readme",
  "bugs": {
    "url": "https://github.com/Korus-Dev/agent-ui-sdk/issues"
  },
  "author": "Nicolas Bonamy",
  "keywords": [
    "agents",
    "vue",
    "electron",
    "chat",
    "multi-harness"
  ],
  "main": "./dist/vue/index.js",
  "types": "./dist/vue/index.d.ts"
}
