{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "assets",
    "native"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/package-katex-assets.mjs dist/styles.css dist/fonts && node scripts/verify-package-css.mjs dist/styles.css dist/vue/index.d.ts dist/fonts && node scripts/verify-native-assets.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && npm run typecheck:composition",
    "typecheck:composition": "vue-tsc -p tsconfig.composition.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "name": "ai-app-sdk",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./host": {
      "types": "./dist/host/contracts.d.ts",
      "import": "./dist/host/contracts.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload.d.ts",
      "import": "./dist/electron/preload.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "import": "./dist/speech/index.js"
    },
    "./browser/*": {
      "types": "./dist/browser/*.d.ts",
      "import": "./dist/browser/*.js"
    },
    "./browser-ui": {
      "types": "./dist/vue/browser/index.d.ts",
      "import": "./dist/vue/browser/index.js"
    },
    "./documents/*": {
      "types": "./dist/documents/*.d.ts",
      "import": "./dist/documents/*.js"
    },
    "./native": {
      "types": "./dist/vue/native/index.d.ts",
      "import": "./dist/vue/native/index.js"
    }
  },
  "dependencies": {
    "multi-agents-sdk": "file:../multi-agents-sdk",
    "@pierre/highlights": "0.2.0",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@tabler/icons-vue": "3.45.0",
    "beautiful-mermaid": "1.1.3",
    "fix-webm-duration": "1.0.6",
    "katex": "0.17.0",
    "marked": "17.0.6",
    "marked-katex-extension": "5.1.10",
    "shiki": "4.3.1",
    "ws": "8.22.2",
    "parse-git-diff": "0.0.20"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "electron": ">=30",
    "element-plus": ">=2.13"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "element-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Reusable capability-driven Vue controls and optional native host adapters for agent applications.",
  "devDependencies": {
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.35",
    "@vue/test-utils": "2.4.11",
    "electron": "43.1.1",
    "element-plus": "2.14.1",
    "jsdom": "29.1.1",
    "vue": "3.5.35",
    "vue-tsc": "3.3.7"
  }
}
